+import 'dart:convert';
+import 'package:flutter_test/flutter_test.dart';
+import '../lib/web_knowledge_explorer_v11.dart';
+import '../lib/reading_memory_v0438.dart';
+
+void main() {
+  test('URL-only source withdrawal invalidates the cached reading view', () {
+    final memory = ResearchMemory11();
+    SourceMemory323.retain(memory, WebDocument11(
+      provider: 'Test', family: 'local', title: 'Glossario',
+      url: 'local://teacher', text: '«zanfra» significa «consegna».', trust: .9));
+    SourceMemory323.retain(memory, WebDocument11(
+      provider: 'Test', family: 'local', title: 'Episodio',
+      url: 'local://retained', text: 'Anna legge il libro.', trust: .9));
+    expect(ReadingMemory438.rows(memory), hasLength(2));
+    final before = (memory.state317['sourceMemory323'] as Map)['revision'] as int;
+    SourceMemory323.forget33(memory, (text) => text == 'local://teacher');
+    final surviving = ReadingMemory438.rows(memory);
+    expect(surviving, hasLength(1));
+    expect(surviving.single['url'], 'local://retained');
+    expect((memory.state317['sourceMemory323'] as Map)['revision'], greaterThan(before));
+    final restored = ResearchMemory11.fromJson(jsonDecode(jsonEncode(memory.toJson())));
+    expect(ReadingMemory438.rows(restored), hasLength(1));
+    expect(ReadingMemory438.rows(restored).single['url'], 'local://retained');
+  });
+}
