(last.isNotEmpty && {'e','ed','di','del','della','dei','degli','delle','da','con','per','and','of','to','with'}.contains(last.last))return false;
    return true;
  }

  static double _verificationPriority0313(ResearchClaim11 c) {
    final missingFamily=c.sourceFamilies.length<2?1.0:0.0;
    final evidence=min(6,c.evidenceCount).toDouble();
    final provider=min(4,c.providerCount).toDouble();
    final objectWords=c.object.trim().split(RegExp(r'\\s+')).where((x)=>x.isNotEmpty).length;
    return 4.0*missingFamily + 3.0*c.confidence + 0.65*evidence + 0.25*provider - 0.06*objectWords;
  }

  static String _semanticStem0313(String raw){
    var x=_root0311(raw);
    if(x.length>5 && x.endsWith('ies'))x='${x.substring(0,x.length-3)}y';
    else if(x.length>5 && x.endsWith('es'))x=x.substring(0,x.length-2);
    else if(x.length>4 && x.endsWith('s'))x=x.substring(0,x.length-1);
    return x;
  }

  static String _semanticObjectKey0313(String object){
    final roots=_contentRoots0311(object)
        .map(_semanticStem0313)
        .where((x)=>x.length>=3)
        .map((x)=>x.length>6?x.substring(0,6):x)
        .toSet()
        .toList()..sort();
    return roots.join(':');
  }

  static String _claimSemanticKey0313(ExtractedClaim11 c) =>
      '${_n11(c.subject)}|${_n11(c.relation)}|${_semanticObjectKey0313(c.object)}|${_n11(c.subjectSenseKey??'')}';

  static bool _objectsEquivalent0313(String a,String b){
    final ar=_contentRoots0311(a).map(_semanticStem0313).toSet();
    final br=_contentRoots0311(b).map(_semanticStem0313).toSet();
    if(ar.isEmpty || br.isEmpty)return false;
    var hits=0;
    for(final x in ar){
      if(br.any((y)=>_rootCompatible0311(x,y)))hits++;
    }
    final score=hits/max(ar.length,br.length);
    return score>=0.67;
  }

  static bool _claimEquivalent0313ToMemory(ExtractedClaim11 a,ResearchClaim11 b){
    return _n11(a.subject)==_n11(b.subject) &&
        _n11(a.relation)==_n11(b.relation) &&
        _objectsEquivalent0313(a.object,b.object);
  }

  static bool _verificationEvidenceSupports0313(
    String sentence,{
    required String documentTitle,
    required String subject,
    required Set<String> subjectAliases,
    required String relation,
    required String object,
  }){
    final subjectOk=_mentions0311(sentence,subject,ratio:0.50) ||
        subjectAliases.any((a)=>_mentions0311(sentence,a,ratio:0.50)) ||
        _mentions0311(documentTitle,subject,ratio:0.50) ||
        subjectAliases.any((a)=>_mentions0311(documentTitle,a,ratio:0.50));
    return subjectOk && _mentions0311(sentence,object,ratio:0.60) && _relationCue0311(sentence,relation);
  }

